<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="drawerArrowStyle">@style/DrawerArrowStyle</item>
        <item name="progressBarStyle">@style/ProgressBarStyle</item>
    </style>
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
    <style name="NavigationTheme" parent="AppTheme">
        <item name="listPreferredItemHeightSmall">40dp</item><!-- menu item height- vary as u need -->
        <item name="listPreferredItemHeight">40dp</item>
    </style>
    <style name="DrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="color">@android:color/black</item>
    </style>
    <style name="ProgressBarStyle">
        <item name="colorAccent">@color/color_progress_center</item>
    </style>

    <style name="NavigationButtonStyle">
        <item name="android:padding">0dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:minWidth">38dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:background">@drawable/item_sel</item>
        <item name="android:textColor">@color/color_navigation_text</item>
    </style>

    <style name="BarButtonStyle">
        <item name="android:padding">0dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:textColor">@color/color_navigation_text</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="ImgButtonStyle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/btn_bg_inv</item>
    </style>

    <style name="DropButtonStyle">
        <item name="android:padding">5dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:textColor">@color/color_dropmenu_text</item>
        <item name="android:background">@drawable/item_sel</item>
    </style>
</resources>