<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginLeft="0dp"
    android:layout_marginTop="0dp"
    android:layout_marginRight="0dp"
    android:layout_marginBottom="5dp"
    android:background="@color/color_list_bg"
    android:padding="5dp">

    <TextView
        android:id="@+id/tx_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/example_date"
        android:textColor="@color/color_list_date"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tx_postID" />

    <TextView
        android:id="@+id/tx_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginLeft="5dp"
        android:text="@string/title"
        android:textColor="@color/color_list_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/btn_bg_inv"
        app:layout_constraintEnd_toStartOf="@+id/barrier5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_url"
        app:layout_constraintVertical_chainStyle="packed" />

    <!--    app:layout_constraintBottom_toBottomOf="@+id/tx_newImg"-->

    <TextView
        android:id="@+id/tx_Summary_Bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:fontFamily="sans-serif"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/example_text"
        android:textColor="@color/color_list_text"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier6" />


    <TextView
        android:id="@+id/tx_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginLeft="5dp"
        android:text="@string/author"
        android:textColor="@color/color_list_author"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/barrier5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tx_title"
        tools:visibility="visible" />


    <TextView
        android:id="@+id/tx_postID"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/list_placeholder_ID"
        android:background="@drawable/btn_bg_inv"
        android:textColor="@color/color_list_postID"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_url" />

    <ImageView
        android:id="@+id/img_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/list_img_descr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:adjustViewBounds="true"
        tools:srcCompat="@tools:sample/avatars" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="left"
        app:constraint_referenced_ids="tx_postID,tx_date" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier6"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tx_title,tx_author,tx_postID,tx_date" />


    <!--unneeded elements, ID required for binding in same recyclerview-->

    <TextView
        android:id="@+id/tx_newImg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        />

    <TextView
        android:id="@+id/tx_Summary_Top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tx_watch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tx_newPosts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />


    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

 </androidx.constraintlayout.widget.ConstraintLayout>
